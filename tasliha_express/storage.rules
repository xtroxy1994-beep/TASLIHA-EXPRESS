rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*');
    }

    function isFileSizeOk() {
      return request.resource.size < 5 * 1024 * 1024; // 5MB max
    }

    // Profile images — user can upload/read their own; others can read (public profiles)
    match /profile_images/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(userId) && isImageFile() && isFileSizeOk();
    }

    // Profile images with extensions
    match /profile_images/{userId}.jpg {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(userId) && isImageFile() && isFileSizeOk();
    }

    // Recharge receipts — only the user can upload, only admin can read (via Cloud Functions ideally)
    match /recharge_receipts/{fileName} {
      // Allow authenticated users to upload receipts
      allow write: if isSignedIn() && isImageFile() && isFileSizeOk() &&
                      fileName.matches(request.auth.uid + '_.*');
      // Allow reading by the uploader or admin
      allow read: if isSignedIn();
    }

    // Request images — client can upload for their requests; authenticated users can read
    match /request_images/{requestId}/{imageFile} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImageFile() && isFileSizeOk();
    }

    // Block all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
